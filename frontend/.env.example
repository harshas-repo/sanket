# Frontend environment. Copy to .env.local for a machine-specific override.
#
# Empty by default on purpose: the app talks to relative paths (/api, /geo) and the Vite dev
# server proxies them to the API. A full URL here means a second origin, CORS in development
# that does not exist in production, and a demo that breaks when the laptop moves.
VITE_API_URL=

# Where the dev server proxies. Only change this if the API is not on 8123.
SANKET_API_TARGET=http://127.0.0.1:8123

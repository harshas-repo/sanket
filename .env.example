# SANKET configuration. Copy to `.env` and edit. Every value below is optional:
# the defaults in `backend/app/config.py` let the whole stack run on a clean
# machine with no keys and no Postgres. Nothing here should ever contain a real
# secret - `.env` is gitignored for that reason.

# ---------------------------------------------------------------- runtime
SANKET_ENV=development

# ---------------------------------------------------------------- persistence
# Default is SQLite at data/sanket.db so the product runs anywhere. Point this at
# PostgreSQL for anything shared; the same models apply unchanged.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sanket
# DATABASE_URL=sqlite:///./data/sanket.db

# ---------------------------------------------------------------- auth
# Signs session tokens (HMAC). If unset, a development default is used and the
# server logs a warning and refuses to create Response Center accounts.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SANKET_SECRET_KEY=
SANKET_TOKEN_TTL_HOURS=12
# Seeds the five demo logins (password: sanket123) and allows self-registration on
# the Response Center surface. Set false before exposing this beyond localhost.
SANKET_ALLOW_DEMO_ACCOUNTS=true

# ---------------------------------------------------------------- ingestion
# Live polling of the official sources. Turn off to run on the data already stored.
SANKET_INGESTION_ENABLED=true
SANKET_SCHEDULER_TICK=15
SANKET_HTTP_TIMEOUT=30
# drrportal.gov.np only answers over plain HTTP. Keep true to reach it, set false to
# make the adapter refuse insecure endpoints.
SANKET_ALLOW_INSECURE_SOURCES=true
# Only events inside this window become incidents (every row is still stored).
SANKET_INCIDENT_WINDOW_DAYS=14
USGS_MIN_MAGNITUDE=3.0
USGS_LOOKBACK_DAYS=7
DRR_LOOKBACK_DAYS=45

# ---------------------------------------------------------------- demo mode
# Arms synthetic data. Demo rows are always labelled in the UI and never mixed
# silently with live ones. Normally armed through /api/demo, not by environment.
SANKET_DEMO_MODE=false

# ---------------------------------------------------------------- language model
# Only used for language understanding (intent, correlation wording, replies).
# Coordinates, distances, times, freshness, scores, urgency, duplicates, status
# transitions and official confirmation are computed in code and never by a model.
# With no key set, the agent runs in a deterministic fallback and says so.
# LLM_PROVIDER names which SDK to drive; leave it empty to infer it from whichever
# key below is set. The key is read by the backend process only - no endpoint and
# no frontend bundle ever receives it.
LLM_PROVIDER=gemini
# Model ids retire. This one answers today; `gemini-2.5-flash` now returns 404 "no longer
# available to new users" against a freshly issued key. Check what a key may use with
#   GET https://generativelanguage.googleapis.com/v1beta/models
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLAMA_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ---------------------------------------------------------------- frontend
# The Vite dev server origins allowed to call this API.
SANKET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The API runs on http://127.0.0.1:8123 in development - the port every smoke script,
# `frontend/.env.example` and the Vite proxy already assume. Frontend settings are NOT read from
# this file (Vite only loads `frontend/.env*`), and `VITE_API_URL` is deliberately left empty in
# `frontend/.env.example`: the app calls relative /api and /geo paths and the dev server proxies
# them, so nothing needs a second origin or a CORS allowance.
